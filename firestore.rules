rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function staff() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function admin() { return staff() && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.role == 'admin'; }
    function str(f, n) { return f is string && f.size() > 0 && f.size() <= n; }

    // admins/{uid} documents are created manually in the Firebase console: { role: "admin" | "editor" }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; }

    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','company','country','service','budget','message','createdAt'])
                    && str(request.resource.data.name, 120) && str(request.resource.data.email, 200) && str(request.resource.data.message, 5000)
                    && request.resource.data.createdAt == request.time;
      allow read, update: if admin(); allow delete: if admin();
    }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','createdAt'])
                    && str(request.resource.data.name, 120) && str(request.resource.data.email, 200) && str(request.resource.data.message, 5000)
                    && request.resource.data.createdAt == request.time;
      allow read, update: if admin(); allow delete: if admin();
    }
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt']) && str(request.resource.data.email, 200) && request.resource.data.createdAt == request.time;
      allow read, update: if admin(); allow delete: if admin();
    }
    match /{col}/{id} {   // posts, projects, testimonials
      allow read: if (col in ['posts','projects','testimonials'] && resource.data.published == true) || (col in ['posts','projects','testimonials'] && staff());
      allow create, update: if col in ['posts','projects','testimonials'] && staff();
      allow delete: if col in ['posts','projects','testimonials'] && admin();
    }
  }
}
